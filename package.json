{
  "name": "stonecut",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node --import tsx --test tests/*.test.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test:saved-sizes": "node --import tsx --test tests/saved-sizes.test.mjs",
    "preview": "vite preview",
    "app:dev": "electron .",
    "app:build": "npm run build && electron-builder --mac",
    "app:mas": "npm run build && electron-builder --mac mas",
    "test:publish": "node --import tsx --test tests/publish.test.mjs",
    "test:frame": "node --import tsx --test tests/weeding-frame.test.mjs",
    "test:cutter": "node --import tsx --test tests/cutter-send.test.mjs"
  },
  "dependencies": {
    "opentype.js": "^2.0.0",
    "polygon-clipping": "^0.15.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.79.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  },
  "main": "electron/main.cjs",
  "description": "Rhinestone template designer with direct Graphtec cutting",
  "author": "T-Shirt Brothers",
  "build": {
    "appId": "com.tshirtbrothers.stonecut",
    "productName": "StoneCut",
    "files": [
      "dist/**",
      "electron/**"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.graphics-design",
      "identity": null,
      "hardenedRuntime": false
    },
    "npmRebuild": false,
    "mas": {
      "target": [
        {
          "target": "mas",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.graphics-design",
      "entitlements": "build/entitlements.mas.plist",
      "entitlementsInherit": "build/entitlements.mas.inherit.plist",
      "hardenedRuntime": false,
      "provisioningProfile": "build/StoneCut_MAS.provisionprofile",
      "identity": "Apple Distribution: kevin johnson (AUJY92SA4D)"
    },
    "buildVersion": "2"
  }
}
